<?xml version="1.0" encoding="UTF-8"?>
<pandory>
    <!-- General settings -->
    <system>
        <!-- Enable debug mode. Write logs to pandory.txt --> 
        <setting name="debug" value="false"/>
        
        <!-- Pandory enables dipswitch changes. Set this to true to disable them. -->
        <setting name="disableDipswitches" value="true"/>
        
        <!-- Define how visible scanlines are. From 0 to 1 -->
        <setting name="scanlineOpacity" value="0.2"/>
        
        <!-- Use "jpinoRoyale" Scanlines -->
        <setting name="useBetterScanlines" value="true"/>
        
        <!-- Enable attract mode by disabling credit insertion -->
        <setting name="disableAutomaticCredits" value="true"/>
        
        <!-- Force disable HD filter, regardless of settings -->
        <setting name="disableForcedQualityFilter" value="true"/>
        
        <!-- Enable/disable smoothing of pixels -->
        <setting name="smoothPixels" value="false"/>
        
        <!-- Force smooth pixels on CGA screens. -->
        <setting name="forceSmoothCGA" value="true" />
        
        <!-- "Fat Chun-Li"-Mode. Use this to disable aspect ratio
             correction and instruct the emulator to fill your screen.
             Can be useful for using 720p on a 4:3 screen, or if you
             are just absolutely bonkers -->
        <setting name="stretchDisplay" value="false" />
        
        <!-- Enable rotation settings, otherwise they are ignored -->
        <setting name="allowRotation" value="false" />
        
        <!-- Enable background music in the menu -->
        <setting name="menuMusic" value="true" />
        
        <!-- Turn off music after this many tracks -->
        <setting name="musicSleepLimit" value="10" />
        
        <!-- Set the background music volume -->
        <setting name="musicVolume" value="10" />
        
        <!-- Downsample Amiga audio to mono automatically if you
             are using a CGA/JAMMA cab with only one audio channel. -->
        <setting name="automaticAmigaMono" value="true" />
    </system>
    
    
    <!-- Enable extra cores, map them to folders on your SD/USB.
         You can also change emulator-level settings here, or
         override any general setting above for a specific core. 
         Using keymap="...", you can also change the button layout for
         a given emulator.
         -->
    <emulators>
        <emulator suffix="A800" folder="atari800" core="atari800" keymap="atari800" />
        <emulator suffix="A2600" folder="atari2600" core="stella2014" keymap="atari2600" />
        <emulator suffix="AMIGA" folder="amiga" core="puae" videoDriver="drm" forceWidth="1060" forceHeight="660" />
        <emulator suffix="AMIGA" folder="amiga1200" core="puae" videoDriver="drm" forceWidth="1060" forceHeight="660" extra="aga" />
        <emulator suffix="ST" folder="atarist" core="hatari" keymap="atarist" />
        <emulator suffix="PICO" folder="genesis" core="picodrive" />
        <emulator suffix="GBA" folder="gba" core="mgba" keymap="gba" />
        <emulator suffix="GBC" folder="gbc" core="gambatte" keymap="gameboy" />
        <emulator suffix="GB" folder="gb" core="gambatte" keymap="gameboy" />
        <emulator suffix="GBLINK" folder="gblink" core="tgbdual" keymap="gameboy" stretchDisplay="true" />
        <emulator suffix="PCE" folder="pce" core="mednafen_pce_fast" keymap="pce" />
        <emulator suffix="32X" folder="32x" core="picodrive" />
        <emulator suffix="GENESIS" folder="genesis" core="picodrive"/>
        <emulator suffix="Script" folder="scripts" core="shell"/>
        <emulator suffix="Ports" folder="ports" core="custom"/>
    </emulators>
    
    <!-- Rom-specific settings. You can also override any of the above,
         or map a certain rom to a certain core, change rom widths and
         heights, remap buttons, use completely different settings etc.
         
         keymap="neogeo"                      // set to neogeo button layout
         core="pce"                           // play the rom in the pce emulator
         customOptions="/path/to/options.cfg" // use specific retroarch options file
         customCfg="/path/to/retroarch.cfg"   // use specific retroarch cfg file
         forceWidth="1500"                    // stretch the 'virtual' viewport to 1500px
         forceHeight="1000"                   // stretch the 'virtual' viewport to 1000px
         speed="200"                          // accelerate supported cores (FBA) to given %
         rotate="3"                           // rotate either 0, 90, 180 or 270 degrees
         rotateMode="4:3"                     // (optional) improve scaling if you rotate a 4:3 game
         
         Note: Using customOptions and customCfg will disable any other
         settings you may have defined.
         
         Note: forcing width/height scales the VIRTUAL viewport inside
         of your available screen size. It is therefore possible
         to set a width of 2000x1000, but still use a 384x224 screen.
         
         Note: not all cores enjoy being scaled and some attempt to
         force aspect ratio. It is best to experiment with small pixel
         increments to get your desired results.
     -->
